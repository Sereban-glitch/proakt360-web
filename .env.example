# ПрорАКТ 360 — переменные окружения (пример, БЕЗ секретов)
# Скопируйте в .env и при необходимости поправьте:
#   cp .env.example .env

# Путь к базе SQLite. ВНИМАНИЕ: Prisma резолвит ОТНОСИТЕЛЬНЫЕ пути от каталога
# prisma/, поэтому дефолт ниже — «file:../db/custom.db» → файл ляжет в db/custom.db
# (рядом с ним же создастся db/uploads/ для фото). Абсолютный путь работает как есть:
#   file:/absolute/path/db.db
# Своё расположение фото (если нужно отдельно от базы): PROAKT_UPLOADS_DIR=/path
DATABASE_URL="file:../db/custom.db"

# ИЗОЛИРОВАННЫЙ ДЕМО-РЕЖИМ (только для локального знакомства с приложением!).
# 1 = мастерские экраны открыты без пароля, пока пароль не задан.
# Производственная установка БЕЗ пароля закрыта (fail-closed): мастерские API
# отвечают 503, а задать пароль удалённо нельзя — только локально:
#   npm run setup:password
# Раскомментируйте строку ниже, чтобы открыть демо:
#PROAKT_DEMO_OPEN=1

# Принудительно помечать cookie сессии флагом Secure (если приложение за
# HTTPS-прокси, который не передаёт x-forwarded-proto):
#PROAKT_FORCE_SECURE_COOKIES=1

# Telegram Bot integration (опционально, для Mini App и вебхука):
#TELEGRAM_BOT_TOKEN="your_bot_token_here"
#WEBAPP_URL="https://your-domain.com/?v=2.2"

